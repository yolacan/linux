declare -r ENV=/home/user                    # Değeri değiştirilemeyen salt-okunur (read-only) bir kabuk değişkeni tanımlar
crontab -e                                   # Geçerli kullanıcının zamanlanmış görev (crontab) tablosunu düzenler
